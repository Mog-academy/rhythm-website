# Optional overrides for Firebase config.
# Defaults are prefilled from Android google-services.json, but you should set
# the proper Firebase Web App ID for production web auth behavior.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_SHARED_SYNC_DOC_ID=
